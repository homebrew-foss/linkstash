{
  "name": "linkstash",
  "version": "1.0.0",
  "type": "module",
  "description": "linkstash is a small experiment for collecting and sharing interesting links and articles you find during the week",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "db:init": "bun run scripts/db-init.ts",
    "db:reindex": "bun run scripts/db-reindex.ts",
    "type-check": "svelte-check --tsconfig ./tsconfig.json",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/sanitize-html": "^2.16.2",
    "js-yaml": "^5.4.2",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.14",
    "posthog-js": "^1.435.8",
    "posthog-node": "^5.55.0",
    "sanitize-html": "^2.18.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "svelte-check": "^4.7.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "keywords": [
    "links",
    "collection",
    "api"
  ],
  "author": "",
  "license": "MIT"
}
